 .../main/assets/shell/manifests/standard.json | 89 +++++++++----------
 1 file changed, 40 insertions(+), 49 deletions(-)

diff --git a/app/src/main/assets/shell/manifests/standard.json b/app/src/main/assets/shell/manifests/standard.json
index ea079ea..5d25f9a 100644
